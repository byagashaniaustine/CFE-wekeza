# WhatsApp Cloud API credentials (Meta for Developers > your app > WhatsApp > API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Any secret string; must match what you enter in the Meta webhook config
WHATSAPP_VERIFY_TOKEN=
PORT=8000
ANTHROPIC_API_KEY=
# Gemini fallback — used when Claude is unavailable or errors
GEMINI_API_KEY=

# Streamlogia log ingest (https://api.streamlogia.com/v1/ingest). Leave the key
# or project id blank to disable shipping — the bot then only logs to stdout.
STREAMLOGIA_API_KEY=
STREAMLOGIA_PROJECT_ID=
# Optional: source label attached to every event (defaults to "cfe-invest-bot").
STREAMLOGIA_SOURCE=
# Optional: override the ingest endpoint (defaults to https://api.streamlogia.com/v1/ingest).
STREAMLOGIA_ENDPOINT=

# ─── State 2 — Onboarding ────────────────────────────────────────────────────
# Optional POST target for captured leads. If set, submitLead POSTs the
# normalized lead as JSON. Leave blank to keep lead capture as logs-only.
LEAD_WEBHOOK_URL=
# Continue-registration URLs per scheme. Sent as a follow-up message after the
# onboarding Flow submits successfully. Leave blank to skip that follow-up.
UTT_ONBOARDING_URL=
DSE_ONBOARDING_URL=
GOVSEC_ONBOARDING_URL=
PENSION_ONBOARDING_URL=

# ─── State 3 — Growth Simulation & DSE Scholar Challenge ─────────────────────
# Approved WhatsApp template names + the URL substituted into each template's
# URL button ({{1}}). If a template name is blank, the bot falls back to a
# "coming soon" text message.
#
# SIMULATION_TEMPLATE_NAME defaults to `jionee_ukuaji` when unset.
# DSE_CHALLENGE_TEMPLATE_NAME defaults to `dse_investment_challenge` when unset.
# (See src/tools/simulation.ts.) Override only if the WhatsApp Manager names change.
SIMULATION_TEMPLATE_NAME=
SIMULATION_URL=
DSE_CHALLENGE_TEMPLATE_NAME=
DSE_CHALLENGE_URL=
